<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CloudKit sync entitlements for the opt-in iCloud history sync.

	  These are safe to commit: the container identifier is derived from the
	  PUBLIC bundle id and carries NO team identifier. The team id comes from the
	  gitignored Local.xcconfig at build time; never write a literal team id here.
	  Any keychain-access-group would use $(AppIdentifierPrefix) (expands at build
	  time), never a literal prefix.

	  Only the team-signed Xcode build (which applies these entitlements + a
	  provisioning profile) actually reaches iCloud. The ad-hoc scripts/bundle.sh
	  release build carries NO entitlement, so PersistenceController's
	  processHasCloudKitEntitlement gate keeps CloudKit mirroring off there —
	  loading a mirrored store unentitled hard-crashes, so this is a crash guard,
	  not just an inert no-op.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.io.github.macrosak.recallyx</string>
	</array>
	<!--
	  Force the CloudKit PRODUCTION environment for every build. Development-
	  signed builds (install-dev.sh) otherwise default to the Development
	  environment and could never sync with the TestFlight/App Store iOS app,
	  which always uses Production. This key is honored for dev-signed builds
	  (its whole purpose) and ignored/forced-to-Production for App Store /
	  TestFlight exports, so it's safe everywhere. Prerequisite: the container
	  schema must be deployed to Production in the CloudKit Console before the
	  first Production sync.
	-->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.io.github.macrosak.recallyx</string>
	</array>
</dict>
</plist>
